{
    "mcpServers": {
        "web-search": {
            "type": "http",
            "url": "http://mcp-search:3000/mcp"
        },
        "codegraph": {
            "type": "stdio",
            "command": "codegraph",
            "args": [
                "serve",
                "--mcp"
            ],
            "env": {
                "CODEGRAPH_TELEMETRY": "0"
            }
        }
    }
}