{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    // src/ is not published, so a map that points at it would be dead weight.
    "inlineSources": true
  },
  "include": ["src"]
}
