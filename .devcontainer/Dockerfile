FROM node:24.20.0-bookworm@sha256:be23f54a88d34e8824c741b19b91064094f92c1c97b194144bfc8b50d67258e2

# Host user identity. Defaults to 1000/1000 but is overridden at build time from
# .devcontainer/.env (generated by the devcontainer initializeCommand).
ARG USER_UID=1000
ARG USER_GID=1000
ARG LOCAL_WORKSPACE_FOLDER

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        git \
        procps \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    && echo 'node ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/node \
    && echo 'Defaults:node env_keep += "HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy"' >> /etc/sudoers.d/node \
    && chmod 0440 /etc/sudoers.d/node

# Align the pre-existing `node` user (uid/gid 1000) with the host user. No-op when the
# host is already 1000:1000. updateRemoteUserUID in devcontainer.json is a second safety net.
RUN if [ "${USER_GID}" != "1000" ]; then groupmod -o -g "${USER_GID}" node; fi \
    && if [ "${USER_UID}" != "1000" ]; then usermod -o -u "${USER_UID}" -g "${USER_GID}" node; fi \
    && mkdir -p /home/node/.vscode-server/extensions /home/node/.claude \
    && chown -R node:node /home/node

ENV COREPACK_HOME=/usr/local/share/corepack
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
COPY package.json /tmp/package.json
RUN corepack enable \
    && mkdir -p "${COREPACK_HOME}" \
    && PNPM_VERSION="$(node -e "const p=require('/tmp/package.json').packageManager||''; const m=p.match(/^pnpm@(.+)$/); process.stdout.write(m ? m[1] : '')")" \
    && rm -f /tmp/package.json \
    && if [ -n "$PNPM_VERSION" ]; then corepack prepare "pnpm@${PNPM_VERSION}" --activate; fi \
    && chown -R node:node "${COREPACK_HOME}" \
    && mkdir -p "${LOCAL_WORKSPACE_FOLDER}/.codegraph" \
    && chown node:node "${LOCAL_WORKSPACE_FOLDER}/.codegraph"

   
RUN npm install --global @colbymchenry/codegraph@1.5.0

USER node